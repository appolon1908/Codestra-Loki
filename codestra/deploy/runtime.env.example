# Copy only variable names into the deployment secret manager.
# Do not commit a populated runtime file.

CODESTRA_ENVIRONMENT=staging
CODESTRA_DEPLOYMENT_ID=replace-with-immutable-release-id
CODESTRA_LOKI_SOURCE_REVISION=0000000000000000000000000000000000000000

LOKI_S3_ENDPOINT=replace-with-private-s3-endpoint
LOKI_S3_REGION=us-east-1
LOKI_S3_CHUNKS_BUCKET=replace-with-loki-chunks-bucket
LOKI_S3_RULER_BUCKET=replace-with-loki-ruler-bucket
LOKI_S3_CREDENTIALS_FILE=/run/secrets/codestra/loki/s3_credentials
LOKI_S3_INSECURE=false

LOKI_ALERTMANAGER_URL=http://alertmanager:9093
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

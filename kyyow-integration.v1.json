{
  "schema": "kyyow.platform-component.v1",
  "repository": "appolon1908-hue/Codestra-Loki",
  "component": "loki",
  "authority": "logs",
  "exposure": "private",
  "native_ports": [
    3100,
    9095,
    7946
  ],
  "inputs": [
    "alloy:logs (Loki push)",
    "opentelemetry:logs (OTLP HTTP)",
    "object-storage:s3"
  ],
  "outputs": [
    "grafana:read (through the private query boundary)",
    "object-storage:s3 (chunks, index and deletion state)"
  ],
  "controls": [
    "tenant, service, environment, and severity are allowed labels",
    "full URLs, emails, names, message bodies, social content, tokens, and secrets are prohibited labels",
    "retention and deletion follow source and tenant policy",
    "native API is not public"
  ],
  "identity": {
    "authority": "appolon1908-hue/Keycloak",
    "workload_identity_required": true,
    "anonymous_admin_access": false
  },
  "secrets": {
    "authority": "appolon1908-hue/Codestra-OpenBao",
    "secrets_in_git": false,
    "environment_plaintext_secrets": false
  },
  "operations": {
    "middleware_is_sole_odoo_writer": true,
    "grafana_read_only": true,
    "superset_read_only": true
  },
  "activation": {
    "source_contract_complete": true,
    "runtime_evidence_complete": false,
    "production_activation_authorized": false
  }
}
